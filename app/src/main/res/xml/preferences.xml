<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="显示设置">

        <ListPreference
            android:key="theme_mode"
            android:title="主题模式"
            android:summary="选择深色/浅色主题"
            android:defaultValue="follow_system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values" />

        <ListPreference
            android:key="columns"
            android:title="列表列数"
            android:summary="设置应用列表的列数"
            android:defaultValue="3"
            android:entries="@array/column_count_entries"
            android:entryValues="@array/column_count_values" />

        <Preference
            android:key="font_color"
            android:title="字体颜色"
            android:summary="点击切换应用名称字体颜色" />

        <Preference
            android:key="background_color"
            android:title="背景颜色"
            android:summary="点击切换主界面背景颜色" />

    </PreferenceCategory>

    <PreferenceCategory android:title="窗口设置">

        <ListPreference
            android:key="window_size"
            android:title="窗口大小"
            android:summary="设置应用窗口大小"
            android:defaultValue="full"
            android:entries="@array/window_size_entries"
            android:entryValues="@array/window_size_values" />

    </PreferenceCategory>

    <PreferenceCategory android:title="功能开关">

        <SwitchPreferenceCompat
            android:key="recent_app_dot"
            android:title="最近更新圆点"
            android:summary="在最近更新的应用图标上显示圆点提示"
            android:defaultValue="true" />

        <ListPreference
            android:key="recent_time_range"
            android:title="最近更新范围"
            android:summary="设置多长时间内更新的应用显示圆点"
            android:defaultValue="432000000"
            android:entries="@array/recent_time_entries"
            android:entryValues="@array/recent_time_values" />

    </PreferenceCategory>

    <PreferenceCategory android:title="键盘快捷应用">

        <ListPreference
            android:key="key_gesture"
            android:title="数字键启动方式"
            android:summary="选择数字键快速启动搜索列表应用的手势（另一个手势用于列表角标启动）"
            android:defaultValue="long_press"
            android:entries="@array/key_gesture_entries"
            android:entryValues="@array/key_gesture_values" />

        <Preference
            android:key="key_binding"
            android:title="数字键绑定应用"
            android:summary="为每个数字键绑定指定应用，按对应键直接启动" />

        <ListPreference
            android:key="swipe_distance"
            android:title="上滑触发距离"
            android:summary="调整上滑手势触发所需的滑动距离"
            android:defaultValue="60"
            android:entries="@array/swipe_distance_entries"
            android:entryValues="@array/swipe_distance_values" />

        <ListPreference
            android:key="long_press_duration"
            android:title="长按触发时长"
            android:summary="调整长按手势触发所需的按住时间"
            android:defaultValue="400"
            android:entries="@array/long_press_duration_entries"
            android:entryValues="@array/long_press_duration_values" />

    </PreferenceCategory>

    <PreferenceCategory android:title="数据管理">

        <Preference
            android:key="hidden_apps"
            android:title="已隐藏的应用"
            android:summary="查看和恢复被隐藏的应用" />

        <Preference
            android:key="import_export_config"
            android:title="导入/导出配置"
            android:summary="二维码扫码传送或剪贴板复制（含界面设置、键位绑定、隐藏应用）" />

    </PreferenceCategory>

</PreferenceScreen>
