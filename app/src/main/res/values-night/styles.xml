<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CategoryChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">@color/category_chip_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_category_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
