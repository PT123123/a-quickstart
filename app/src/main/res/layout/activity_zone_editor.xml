<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF101418"
    android:fitsSystemWindows="true">

    <!-- 顶栏：取消 / 标题 / 保存 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/btn_zones_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕ 取消"
            android:textColor="#FFBBBBBB"
            android:textSize="15sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="图标避让区域"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/btn_zones_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存"
            android:textColor="#FF64B5F6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="在背景上点按或拖动画出区域（图标会避开）；拖动区域可移动，选中后可在下方调整大小或删除"
        android:textColor="#FF8A9199"
        android:textSize="12sp"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp" />

    <!-- 背图画布（比例与主界面背景显示区一致，代码中按该比例放入） -->
    <FrameLayout
        android:id="@+id/zone_canvas_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <ProgressBar
            android:id="@+id/zone_canvas_loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FF64B5F6" />
    </FrameLayout>

    <!-- 选中区域的大小滑杆 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大小"
            android:textColor="#FFBBBBBB"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/sb_zone_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:max="100"
            android:progress="50" />
    </LinearLayout>

    <!-- 底部操作：形状 + 删除 + 清空 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btn_shape_circle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="● 圆形"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_shape_rect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="▢ 方形"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_zone_delete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="删除所选"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_zone_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="清空"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
