<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <!-- ================= 顶部信息区 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorPrimary"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sort_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="智能排序"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:drawableEnd="@drawable/ic_arrow_drop"
                android:drawablePadding="4dp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/btn_settings_top"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="⚙"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:gravity="center"
                android:contentDescription="设置"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/t9_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/t9_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:minHeight="28dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/category_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/CategoryChip" android:text="最近搜索" />
                <TextView style="@style/CategoryChip" android:text="最近使用" />
                <TextView style="@style/CategoryChip" android:text="最近安装" />
                <TextView style="@style/CategoryChip" android:text="社交" />
                <TextView style="@style/CategoryChip" android:text="影音" />
                <TextView style="@style/CategoryChip" android:text="交通出行" />
                <TextView style="@style/CategoryChip" android:text="实用工具" />
                <TextView style="@style/CategoryChip" android:text="游戏" />
                <TextView style="@style/CategoryChip" android:text="购物" />
                <TextView style="@style/CategoryChip" android:text="理财" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ================= 中间应用列表区 ================= -->
    <FrameLayout
        android:id="@+id/bg_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 背景图片层：高度固定为「列表区最大高度」，顶部对齐。
             键盘收起/展开时尺寸不变，因此不会跟着放大或缩小 -->
        <ImageView
            android:id="@+id/bg_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:scaleType="centerCrop"
            android:adjustViewBounds="false"
            android:importantForAccessibility="no" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 启动加载提示 -->
        <LinearLayout
            android:id="@+id/loading_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在加载应用…"
                android:textColor="@color/hint_text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="48dp"
            android:text="没有匹配的应用"
            android:textColor="@color/hint_text"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ================= 底部 T9 九键键盘（3×4） ================= -->
    <!-- 收缩/展开按钮 -->
    <TextView
        android:id="@+id/btn_toggle_keypad"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:text="⌄"
        android:textColor="#888888"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@color/keypad_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="收起/展开键盘" />

    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/keypad_bg"
        android:padding="6dp"
        android:elevation="8dp">

        <!-- 第 1 行：1  2  3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <FrameLayout android:id="@+id/key_1" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_1_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_1_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_1_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:id="@+id/key_2" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_2_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_2_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ABC" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_2_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:id="@+id/key_3" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_3_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_3_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEF" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_3_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第 2 行：4  5  6 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <FrameLayout android:id="@+id/key_4" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_4_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_4_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GHI" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_4_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:id="@+id/key_5" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_5_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_5_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JKL" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_5_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:id="@+id/key_6" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_6_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_6_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MNO" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_6_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第 3 行：7  8  9 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <FrameLayout android:id="@+id/key_7" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_7_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_7_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PQRS" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_7_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:id="@+id/key_8" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_8_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_8_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TUV" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_8_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
            <FrameLayout android:id="@+id/key_9" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/key_9_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:id="@+id/key_9_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WXYZ" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
                <ImageView android:id="@+id/key_9_bind" android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="bottom|end" android:layout_margin="3dp" android:scaleType="fitCenter" android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 第 4 行：清空  0  退格 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <FrameLayout android:id="@+id/key_clear" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="✕" android:textSize="20sp" android:textColor="@color/t9_key_text" />
            </FrameLayout>
            <FrameLayout android:id="@+id/key_0" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>
            <FrameLayout android:id="@+id/key_back" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="3dp" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true" android:longClickable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="⌫" android:textSize="20sp" android:textColor="@color/t9_key_text" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
