<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <!-- ================= 顶部信息区 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorPrimary"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sort_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="智能排序"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:drawableEnd="@drawable/ic_arrow_drop"
                android:drawablePadding="4dp"
                android:gravity="center_vertical" />

            <TextView
                android:id="@+id/btn_clear_top"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✕"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:gravity="center"
                android:contentDescription="清空" />
        </LinearLayout>

        <TextView
            android:id="@+id/t9_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="可以输入 '577' 来搜索 '计算器'"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/t9_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:minHeight="28dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/category_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView style="@style/CategoryChip" android:text="最近搜索" />
                <TextView style="@style/CategoryChip" android:text="最近安装" />
                <TextView style="@style/CategoryChip" android:text="社交" />
                <TextView style="@style/CategoryChip" android:text="影音" />
                <TextView style="@style/CategoryChip" android:text="交通出行" />
                <TextView style="@style/CategoryChip" android:text="实用工具" />
                <TextView style="@style/CategoryChip" android:text="游戏" />
                <TextView style="@style/CategoryChip" android:text="购物" />
                <TextView style="@style/CategoryChip" android:text="理财" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ================= 中间应用列表区 ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/app_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="48dp"
            android:text="没有匹配的应用"
            android:textColor="#888888"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ================= 底部 T9 九键键盘（3×4） ================= -->
    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EEEEEE"
        android:padding="6dp"
        android:elevation="8dp">

        <!-- 第 1 行：1  2  3 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/key_1" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_1_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_1_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key_2" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_2_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_2_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ABC" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key_3" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_3_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_3_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DEF" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第 2 行：4  5  6 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/key_4" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_4_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_4_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GHI" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key_5" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_5_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_5_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="JKL" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key_6" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_6_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_6_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MNO" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第 3 行：7  8  9 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/key_7" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_7_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_7_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PQRS" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key_8" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_8_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_8_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TUV" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key_9" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/key_9_num" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:id="@+id/key_9_alpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WXYZ" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第 4 行：清空  0  退格 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:id="@+id/key_clear" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✕" android:textSize="20sp" android:textColor="@color/t9_key_text" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key_0" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/t9_key_text" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A" android:textSize="10sp" android:textColor="@color/t9_key_letter" android:includeFontPadding="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/key_back" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_margin="3dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_t9_key" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌫" android:textSize="20sp" android:textColor="@color/t9_key_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
