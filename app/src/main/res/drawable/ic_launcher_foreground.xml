<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的前景层：把原始方形 logo 放进 108dp 画布中央的安全区。

  两层缩放要一起算：
  1. adaptive icon 的 108dp 画布里，只有中央约 66~72dp 保证不被 launcher 的
     圆形 / 圆角遮罩裁掉，超出部分会被啃掉；
  2. 原图 ic_launcher_logo.png 本身四周就留了 14/192 ≈ 7.3% 的边
     （可见内容只占画布 85%），这部分留白会被一起缩进来。

  所以内缩量取 15dp：画布 108 - 15*2 = 78dp 装图，
  图内 85% 的实际内容 ≈ 66dp，正好落在安全区里。
  （之前内缩 21dp → 内容只剩 62dp，比其它应用图标明显偏小。）
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_launcher_logo"
        android:left="15dp"
        android:top="15dp"
        android:right="15dp"
        android:bottom="15dp" />
</layer-list>