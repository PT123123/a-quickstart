<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：完全透明，桌面壁纸直接透上来。

  为什么必须是 adaptive-icon 而不是单张 legacy PNG：
  Android 8.0 之前，桌面（launcher）拿到的是 mipmap/ic_launcher.png 这类方图，
  系统会主动给它套一层**自己的**白色圆角遮罩来「美化」，于是四周凭空多出白底——
  那不是图片自带的，PNG 本身是透明的。adaptive-icon 出现后遮罩由 launcher 自己画，
  我们才能把底色真正留成透明。

  这里用 layer-list 包一层而不是直接写 color，是为了部分国产launcher
  对「纯 color drawable 作为 background 层」的兼容性更稳。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/transparent" />
</layer-list>